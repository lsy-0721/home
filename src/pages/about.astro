---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

const facts: Array<[string, string]> = [
  ["姓名", "鱼裕 / YUYU"],
  ["学校", "哈尔滨理工大学"],
  ["专业", "数据科学与大数据技术 (2024–2028)"],
  ["位置", "哈尔滨 · 中国"],
];

const interests = ["Web 开发", "分布式系统", "数据分析", "AI 应用", "二次元游戏", "数字音乐"];
const timeline = [
  { when: "2024.09", what: "进入哈理工，开启大数据学习" },
  { when: "2025.03", what: "接触 Hadoop / Hive，做了第一个数据分析课程设计" },
  { when: "2025.07", what: "暑期搭建 Spark 实验环境，开始个人项目" },
  { when: "2025.10", what: "用 Astro 重构个人主页" },
];
---
<BaseLayout title="About · YUYU" description="关于鱼裕 · YUYU 的学习、兴趣与时间线">
  <p class="eyebrow">ABOUT ME</p>
  <h1>关于我</h1>

  <div class="about-grid fade-in">
    <section class="panel">
      <h2>{site.name} / {site.enName}</h2>
      <p>哈尔滨理工大学 · 数据科学与大数据技术 · 2024–2028。本科在读，关注 Web、大数据与 AI，同时是一名资深二次元。</p>
      <ul class="fact-list">
        {facts.map(([k, v]) => (
          <li><span class="k">{k}</span><span class="v">{v}</span></li>
        ))}
      </ul>
      <div class="tags">
        {interests.map((t) => <span>{t}</span>)}
      </div>
    </section>

    <section class="panel">
      <h2>近期时间线</h2>
      <ul class="timeline">
        {timeline.map((e) => (
          <li>
            <div class="when">{e.when}</div>
            <div class="what">{e.what}</div>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <Footer />
</BaseLayout>
