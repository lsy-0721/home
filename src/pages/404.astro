---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="404 · YUYU" description="页面飞走了">
  <p class="eyebrow">404</p>
  <h1>页面飞走了</h1>
  <p style="color:var(--fg-muted);max-width:60ch;">
    你找的页面已经不在这里 — 可能是地址打错了，或者内容已被搬到别处。
    先回首页逛逛，或者去博客看看最近写的文字。
  </p>
  <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:30px;">
    <a class="back" href="/" style="margin:0;">← 回首页</a>
    <a class="back" href="https://www.execute.cc.cd/" target="_blank" rel="noreferrer noopener" style="margin:0;">
      去博客 ↗
    </a>
  </div>
</BaseLayout>
