---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/content";

const statusClass = (s: string) =>
  s === "已完成" ? "status done" : s === "归档" ? "status archive" : "status";
---
<BaseLayout title="Projects · YUYU" description="鱼裕的个人项目：已完成 / 进行中 / 归档">
  <p class="eyebrow">PROJECTS</p>
  <h1>项目</h1>

  <div class="list fade-in">
    {projects.map((p) => (
      <article class="panel">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px;">
          <div>
            <h2>{p.name}</h2>
            <p>{p.desc}</p>
            <div class="tags">
              {p.tags.map((t) => <span>{t}</span>)}
            </div>
          </div>
          <span class={statusClass(p.status)}>{p.status}</span>
        </div>
        {p.repo && (
          <a
            href={p.repo}
            target="_blank"
            rel="noreferrer"
            style="display:inline-block;margin-top:14px;color:var(--accent);font-size:12px;text-decoration:none;"
          >
            查看代码 ↗
          </a>
        )}
      </article>
    ))}
  </div>

  <Footer />
</BaseLayout>
